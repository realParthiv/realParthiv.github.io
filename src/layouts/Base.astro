---
import '../styles/global.css';

// Fontsource packages
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative path to a social share image. */
  image?: string;
  /** Open Graph object type. Use "article" on blog posts and case studies. */
  type?: 'website' | 'article';
  /** ISO date, emitted as article:published_time when type is "article". */
  publishedTime?: string;
}

const {
  title,
  description = 'Parthiv Parmar — AI/ML engineer building production systems: autonomous agents over MCP, RAG pipelines that refuse to hallucinate, and high-throughput Django backends.',
  image = '/og/default.png',
  type = 'website',
  publishedTime
} = Astro.props;

const pageTitle = title ? `Parthiv Parmar | ${title}` : 'Parthiv Parmar — AI/ML Engineer';
const currentYear = new Date().getFullYear();

// Cloudflare Web Analytics beacon. Cookie-less, no consent banner needed.
// Unset in an environment (no PUBLIC_CF_BEACON_TOKEN) and the tag simply
// doesn't render — safe by default, nothing to break on deploy.
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;

// Google Search Console domain verification (the "meta tag" ownership-proof
// method). Set PUBLIC_GOOGLE_SITE_VERIFICATION to the content value GSC gives
// you; unset and the tag simply doesn't render.
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

// Astro.site is set in astro.config.mjs; these resolve to absolute URLs,
// which is what crawlers and social scrapers require.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);

// Describe the card the way a screen reader would need it, per page.
const imageAlt = title
  ? `${title} — Parthiv Parmar`
  : 'Parthiv Parmar — AI/ML Engineer';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Parthiv Parmar',
  url: Astro.site?.href,
  jobTitle: 'AI/ML Engineer',
  email: 'mailto:parthivp848@gmail.com',
  worksFor: { '@type': 'Organization', name: 'Clicode' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'GLS University, Ahmedabad' },
  sameAs: [
    'https://github.com/realParthiv',
    'https://linkedin.com/in/parthivparmar'
  ]
};

// Per-post rich-result eligibility. Only emitted on article pages, where
// publishedTime is set by the blog [slug] route.
const articleSchema = type === 'article' && publishedTime ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: socialImageURL.href,
  datePublished: publishedTime,
  url: canonicalURL.href,
  author: { '@type': 'Person', name: 'Parthiv Parmar', url: Astro.site?.href },
  publisher: { '@type': 'Person', name: 'Parthiv Parmar' },
  mainEntityOfPage: canonicalURL.href
} : null;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- favicon.ico is the fallback browsers auto-probe for non-HTML responses
       (an image URL opened directly has no <head> to read these from). -->
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta name="author" content="Parthiv Parmar" />
  <link rel="alternate" type="application/rss+xml" title="Parthiv Parmar — Log" href="/rss.xml" />
  {googleSiteVerification && (
    <meta name="google-site-verification" content={googleSiteVerification} />
  )}

  <!-- Open Graph -->
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="Parthiv Parmar" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={socialImageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={imageAlt} />
  <meta property="og:locale" content="en_US" />
  {type === 'article' && publishedTime && (
    <meta property="article:published_time" content={publishedTime} />
  )}

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImageURL} />
  <meta name="twitter:image:alt" content={imageAlt} />

  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />
  {articleSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} is:inline />
  )}

  {cfBeaconToken && (
    <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${cfBeaconToken}"}`}></script>
  )}

  <script is:inline>
    (function() {
      // Dark is the deliberate default
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
</head>
<body class="bg-light-bg dark:bg-dark-bg text-light-text dark:text-dark-text font-body transition-colors duration-300 relative selection:bg-light-accent/30 dark:selection:bg-dark-accent/30 overflow-x-clip">
  
  <!-- Ambient Background Glows -->
  <div class="pointer-events-none fixed inset-0 overflow-hidden z-0">
    <div class="absolute -top-[20%] -left-[10%] w-[50%] h-[50%] rounded-full bg-light-glow dark:bg-dark-glow blur-[120px] opacity-70"></div>
    <div class="absolute top-[40%] -right-[20%] w-[40%] h-[60%] rounded-full bg-light-glow dark:bg-dark-glow blur-[150px] opacity-40"></div>
  </div>

  <!-- Nav -->
  <header class="sticky top-0 z-50 bg-light-bg/70 dark:bg-dark-bg/70 backdrop-blur-md border-b border-light-hairline dark:border-dark-hairline transition-colors duration-300">
    <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
      <!-- Left: Typographic Brand Logo -->
      <a href="/" class="flex-shrink-0 group" aria-label="Home">
        <div class="font-display font-semibold text-lg tracking-tight">
          <span class="text-light-text dark:text-dark-text transition-colors">Parthiv</span><span class="text-light-accent dark:text-dark-accent transition-colors group-hover:opacity-80">.</span>
        </div>
      </a>

      <!-- Right: Links & Theme Toggle -->
      <nav class="flex items-center gap-6">
        <div class="hidden sm:flex items-center gap-6 text-sm font-medium">
          <a href="/work" class="text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-dark-text transition-colors">Work</a>
          <a href="/about" class="text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-dark-text transition-colors">About</a>
          <a href="/blog" class="text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-dark-text transition-colors">Blog</a>
          <a href="/contact" class="text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-dark-text transition-colors">Contact</a>
        </div>
        
        <div class="w-px h-4 bg-light-hairline dark:bg-dark-hairline hidden sm:block"></div>
        
        <button id="theme-toggle" class="text-sm font-medium text-light-text dark:text-dark-text hover:text-light-accent dark:hover:text-dark-accent transition-colors flex items-center gap-2" aria-label="Toggle theme">
          <span id="theme-label">Light</span>
        </button>

        <div class="w-px h-4 bg-light-hairline dark:bg-dark-hairline sm:hidden"></div>

        <button id="mobile-menu-btn" class="sm:hidden text-sm font-medium text-light-text dark:text-dark-text hover:text-light-accent dark:hover:text-dark-accent transition-colors uppercase tracking-widest" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu-overlay">
          Menu
        </button>
      </nav>
    </div>
  </header>

  <!-- Mobile Menu Overlay -->
  <!-- `inert` keeps the off-screen links out of the tab order and the a11y tree
       until the menu is actually opened. Without it they stay focusable at every
       breakpoint, including desktop where the menu can never be shown. -->
  <div id="mobile-menu-overlay" inert aria-hidden="true" class="fixed inset-0 z-40 bg-light-bg/95 dark:bg-dark-bg/95 backdrop-blur-xl translate-x-full transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] flex flex-col justify-center px-8">
    <nav class="flex flex-col gap-8 text-4xl font-display font-medium tracking-tight">
      <a href="/" class="mobile-link text-light-text dark:text-dark-text hover:text-light-accent dark:hover:text-dark-accent transition-colors">Home</a>
      <a href="/work" class="mobile-link text-light-text dark:text-dark-text hover:text-light-accent dark:hover:text-dark-accent transition-colors">Work</a>
      <a href="/about" class="mobile-link text-light-text dark:text-dark-text hover:text-light-accent dark:hover:text-dark-accent transition-colors">About</a>
      <a href="/blog" class="mobile-link text-light-text dark:text-dark-text hover:text-light-accent dark:hover:text-dark-accent transition-colors">Blog</a>
      <a href="/contact" class="mobile-link text-light-text dark:text-dark-text hover:text-light-accent dark:hover:text-dark-accent transition-colors">Contact</a>
    </nav>
  </div>

  <!-- Main Content -->
  <main class="max-w-5xl mx-auto px-6 pt-4 pb-16 min-h-screen relative z-10">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="border-t border-light-hairline dark:border-dark-hairline transition-colors duration-300 mt-20 relative z-10 bg-light-bg/50 dark:bg-dark-bg/50 backdrop-blur-sm">
    <div class="max-w-5xl mx-auto px-6 py-16 flex flex-col gap-8">
      <!-- Row 1: Nav Links -->
      <nav class="flex flex-wrap gap-6 text-sm font-medium">
        <a href="/work" class="text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-dark-text transition-colors">Work</a>
        <a href="/about" class="text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-dark-text transition-colors">About</a>
        <a href="/blog" class="text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-dark-text transition-colors">Blog</a>
        <a href="/contact" class="text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-dark-text transition-colors">Contact</a>
      </nav>

      <!-- Row 2: Socials -->
      <div class="font-data text-xs flex flex-wrap gap-x-4 gap-y-3">
        <a href="https://github.com/realParthiv" target="_blank" rel="noopener noreferrer" class="text-light-muted dark:text-dark-muted hover:text-light-accent dark:hover:text-dark-accent transition-colors flex items-center gap-1.5">
          <span>GitHub</span>
          <span class="opacity-50">&nearr;</span>
        </a>
        <a href="https://linkedin.com/in/parthivparmar" target="_blank" rel="noopener noreferrer" class="text-light-muted dark:text-dark-muted hover:text-light-accent dark:hover:text-dark-accent transition-colors flex items-center gap-1.5">
          <span>LinkedIn</span>
          <span class="opacity-50">&nearr;</span>
        </a>
        <a href="mailto:parthivp848@gmail.com" class="text-light-muted dark:text-dark-muted hover:text-light-accent dark:hover:text-dark-accent transition-colors flex items-center gap-1.5">
          <span>Email</span>
          <span class="opacity-50">&rarr;</span>
        </a>
      </div>

      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 mt-8 pt-8 border-t border-light-hairline dark:border-dark-hairline">
        <!-- Row 3: Current Status -->
        <div class="font-data text-xs text-light-muted dark:text-dark-muted">
          currently @ <span class="text-light-text dark:text-dark-text">Clicode</span> — AI/ML Engineer
        </div>

        <!-- Row 4: Copyright -->
        <div class="text-xs text-light-muted dark:text-dark-muted">
          &copy; {currentYear} Parthiv Parmar. Verified by code.
        </div>
      </div>
    </div>
  </footer>

  <script>
    // Theme toggle logic
    const themeToggle = document.getElementById('theme-toggle');
    const themeLabel = document.getElementById('theme-label');
    
    // Set initial label based on current class
    const isDark = document.documentElement.classList.contains('dark');
    if (themeLabel) {
      themeLabel.textContent = isDark ? 'Light' : 'Dark';
    }

    themeToggle?.addEventListener('click', () => {
      const html = document.documentElement;
      const willBeDark = !html.classList.contains('dark');
      
      if (willBeDark) {
        html.classList.add('dark');
        localStorage.setItem('theme', 'dark');
        if (themeLabel) themeLabel.textContent = 'Light';
      } else {
        html.classList.remove('dark');
        localStorage.setItem('theme', 'light');
        if (themeLabel) themeLabel.textContent = 'Dark';
      }
    });

    // Mobile menu logic
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileOverlay = document.getElementById('mobile-menu-overlay');

    if (mobileBtn && mobileOverlay) {
      const firstLink = mobileOverlay.querySelector<HTMLAnchorElement>('.mobile-link');
      let menuOpen = false;

      const setMenu = (open: boolean) => {
        menuOpen = open;
        mobileOverlay.classList.toggle('translate-x-full', !open);
        mobileOverlay.classList.toggle('translate-x-0', open);
        // inert + aria-hidden must track the visual state, or the links stay
        // reachable by keyboard and screen reader while the menu looks closed.
        mobileOverlay.toggleAttribute('inert', !open);
        mobileOverlay.setAttribute('aria-hidden', String(!open));
        mobileBtn.setAttribute('aria-expanded', String(open));
        mobileBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        mobileBtn.textContent = open ? 'Close' : 'Menu';
        document.body.style.overflow = open ? 'hidden' : '';
      };

      mobileBtn.addEventListener('click', () => {
        setMenu(!menuOpen);
        // Move focus into the panel so keyboard users land somewhere useful.
        if (menuOpen) firstLink?.focus();
      });

      document.querySelectorAll('.mobile-link').forEach(link => {
        link.addEventListener('click', () => setMenu(false));
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menuOpen) {
          setMenu(false);
          mobileBtn.focus();
        }
      });
    }
  </script>
</body>
</html>
