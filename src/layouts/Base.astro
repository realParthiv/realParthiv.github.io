---
import '../styles/global.css';

// Fontsource packages
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';

const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Parthiv Parmar</title>
  
  <script is:inline>
    (function() {
      // Dark is the deliberate default
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
</head>
<body class="bg-light-bg dark:bg-dark-bg text-light-text dark:text-dark-text font-body transition-colors duration-200">
  <!-- Nav -->
  <header class="sticky top-0 z-50 bg-light-bg dark:bg-dark-bg border-b border-light-hairline dark:border-dark-hairline transition-colors duration-200">
    <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
      <!-- Left: Brand Seal -->
      <a href="/" class="flex-shrink-0" aria-label="Home">
        <div class="w-9 h-9 rounded-full border border-light-accent dark:border-dark-accent flex items-center justify-center">
          <span class="font-display font-semibold text-light-accent dark:text-dark-accent text-sm leading-none mt-0.5">PP</span>
        </div>
      </a>

      <!-- Right: Links & Theme Toggle -->
      <nav class="flex items-center gap-6">
        <div class="hidden sm:flex items-center gap-6 text-sm font-medium">
          <a href="/work" class="hover:text-light-accent dark:hover:text-dark-accent transition-colors">Work</a>
          <a href="/about" class="hover:text-light-accent dark:hover:text-dark-accent transition-colors">About</a>
          <a href="/blog" class="hover:text-light-accent dark:hover:text-dark-accent transition-colors">Blog</a>
          <a href="/contact" class="hover:text-light-accent dark:hover:text-dark-accent transition-colors">Contact</a>
        </div>
        
        <button id="theme-toggle" class="text-sm font-medium hover:text-light-accent dark:hover:text-dark-accent transition-colors" aria-label="Toggle theme">
          <span id="theme-label">Light</span>
        </button>
      </nav>
    </div>
  </header>

  <!-- Main Content -->
  <main class="max-w-5xl mx-auto px-6 py-12 min-h-screen">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="border-t border-light-hairline dark:border-dark-hairline transition-colors duration-200 mt-20">
    <div class="max-w-5xl mx-auto px-6 py-12 flex flex-col gap-6">
      <!-- Row 1: Nav Links -->
      <nav class="flex gap-6 text-sm font-medium">
        <a href="/work" class="hover:text-light-accent dark:hover:text-dark-accent transition-colors">Work</a>
        <a href="/about" class="hover:text-light-accent dark:hover:text-dark-accent transition-colors">About</a>
        <a href="/blog" class="hover:text-light-accent dark:hover:text-dark-accent transition-colors">Blog</a>
        <a href="/contact" class="hover:text-light-accent dark:hover:text-dark-accent transition-colors">Contact</a>
      </nav>

      <!-- Row 2: Socials -->
      <div class="font-data text-xs flex flex-wrap gap-x-3 gap-y-2">
        <a href="https://github.com/realParthiv" target="_blank" rel="noopener noreferrer" class="hover:text-light-accent dark:hover:text-dark-accent transition-colors">GitHub — github.com/realParthiv</a>
        <span class="text-light-muted dark:text-dark-muted hidden sm:inline">&middot;</span>
        <a href="https://linkedin.com/in/parthivparmar" target="_blank" rel="noopener noreferrer" class="hover:text-light-accent dark:hover:text-dark-accent transition-colors">LinkedIn — linkedin.com/in/parthivparmar</a>
        <span class="text-light-muted dark:text-dark-muted hidden sm:inline">&middot;</span>
        <a href="mailto:parthivp848@gmail.com" class="hover:text-light-accent dark:hover:text-dark-accent transition-colors">Email — parthivp848@gmail.com</a>
      </div>

      <!-- Row 3: Current Status -->
      <div class="font-data text-xs text-light-muted dark:text-dark-muted">
        currently @ Clicode — AI/ML Engineer
      </div>

      <!-- Row 4: Copyright -->
      <div class="text-xs text-light-muted dark:text-dark-muted">
        &copy; {currentYear} Parthiv Parmar
      </div>
    </div>
  </footer>

  <script>
    // Theme toggle logic
    const themeToggle = document.getElementById('theme-toggle');
    const themeLabel = document.getElementById('theme-label');
    
    // Set initial label based on current class
    const isDark = document.documentElement.classList.contains('dark');
    if (themeLabel) {
      themeLabel.textContent = isDark ? 'Light' : 'Dark';
    }

    themeToggle?.addEventListener('click', () => {
      const html = document.documentElement;
      const willBeDark = !html.classList.contains('dark');
      
      if (willBeDark) {
        html.classList.add('dark');
        localStorage.setItem('theme', 'dark');
        if (themeLabel) themeLabel.textContent = 'Light';
      } else {
        html.classList.remove('dark');
        localStorage.setItem('theme', 'light');
        if (themeLabel) themeLabel.textContent = 'Dark';
      }
    });
  </script>
</body>
</html>
