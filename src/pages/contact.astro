---
import Base from '../layouts/Base.astro';
---

<Base>
  <article class="space-y-12 animate-fade-up max-w-[65ch]">
    
    <header class="space-y-6">
      <h1 class="font-display text-2xl font-medium text-light-text dark:text-dark-text uppercase tracking-wider">Contact</h1>
      <p class="font-body text-lg text-light-text dark:text-dark-text leading-relaxed">
        Reaching out is easier than booking a puja through my own chatbot.
      </p>
    </header>

    <div class="flex flex-col gap-6 pt-4">
      <a href="mailto:parthivp848@gmail.com" class="group flex flex-col sm:flex-row sm:items-baseline gap-2 pb-6 border-b border-light-hairline dark:border-dark-hairline hover:bg-light-surface/50 dark:hover:bg-dark-surface/50 transition-colors -mx-4 px-4 rounded-lg">
        <span class="font-display font-medium text-lg text-light-text dark:text-dark-text group-hover:text-light-accent dark:group-hover:text-dark-accent transition-colors w-32">Email</span>
        <span class="font-data text-light-muted dark:text-dark-muted group-hover:text-light-text dark:group-hover:text-dark-text transition-colors">parthivp848@gmail.com</span>
      </a>

      <a href="https://linkedin.com/in/parthivparmar" target="_blank" rel="noopener noreferrer" class="group flex flex-col sm:flex-row sm:items-baseline gap-2 pb-6 border-b border-light-hairline dark:border-dark-hairline hover:bg-light-surface/50 dark:hover:bg-dark-surface/50 transition-colors -mx-4 px-4 rounded-lg">
        <span class="font-display font-medium text-lg text-light-text dark:text-dark-text group-hover:text-light-accent dark:group-hover:text-dark-accent transition-colors w-32">LinkedIn</span>
        <span class="font-data text-light-muted dark:text-dark-muted group-hover:text-light-text dark:group-hover:text-dark-text transition-colors">linkedin.com/in/parthivparmar</span>
      </a>

      <a href="https://github.com/realParthiv" target="_blank" rel="noopener noreferrer" class="group flex flex-col sm:flex-row sm:items-baseline gap-2 pb-6 border-b border-transparent hover:bg-light-surface/50 dark:hover:bg-dark-surface/50 transition-colors -mx-4 px-4 rounded-lg">
        <span class="font-display font-medium text-lg text-light-text dark:text-dark-text group-hover:text-light-accent dark:group-hover:text-dark-accent transition-colors w-32">GitHub</span>
        <span class="font-data text-light-muted dark:text-dark-muted group-hover:text-light-text dark:group-hover:text-dark-text transition-colors">github.com/realParthiv</span>
      </a>
    </div>

  </article>
</Base>
