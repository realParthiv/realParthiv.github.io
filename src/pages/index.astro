      </div>
    </section>

    <!-- 5. VERIFIED CAPABILITIES -->
    <!-- 5. VERIFIED CAPABILITIES -->
    <VerifiedCapabilities />

    <!-- 6. BLOG TEASER -->
    <section class="reveal-on-scroll">
      <h2 class="font-display text-sm text-light-muted dark:text-dark-muted mb-8 uppercase tracking-wider">Log</h2>
      
      {recentBlogEntries.length === 0 ? (
        <div class="font-data text-sm text-light-muted dark:text-dark-muted py-8 border-y border-light-hairline dark:border-dark-hairline text-center">
          No entries logged yet. First one's coming.
        </div>
      ) : (
        <div class="flex flex-col border-t border-light-hairline dark:border-dark-hairline">
          {recentBlogEntries.map(entry => (
            <a href={`/blog/${entry.id}`} class="group py-6 border-b border-light-hairline dark:border-dark-hairline hover:bg-light-surface/50 dark:hover:bg-dark-surface/50 transition-colors">
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 mb-2">
                <h3 class="font-display font-medium text-lg text-light-text dark:text-dark-text group-hover:text-light-accent dark:group-hover:text-dark-accent transition-colors">
                  {entry.data.title}
                </h3>
                <time class="font-data text-xs text-light-muted dark:text-dark-muted" datetime={entry.data.date.toISOString()}>
                  {entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
              </div>
              <p class="text-sm text-light-muted dark:text-dark-muted line-clamp-2">
                {entry.data.excerpt}
              </p>
            </a>
          ))}
        </div>
      )}
    </section>

    <!-- 7. CONTACT / CTA -->
    <section class="reveal-on-scroll mb-16">
      <h2 class="font-display text-sm text-light-muted dark:text-dark-muted mb-8 uppercase tracking-wider">Contact</h2>
      <p class="font-body text-lg mb-8">
        Reaching out is easier than booking a puja through my own chatbot.
      </p>
      <div class="flex flex-wrap gap-8 text-xl font-medium">
        <a href="mailto:parthivp848@gmail.com" class="hover:text-light-accent dark:hover:text-dark-accent transition-colors border-b border-transparent hover:border-light-accent dark:hover:border-dark-accent pb-1">Email</a>
        <a href="https://linkedin.com/in/parthivparmar" target="_blank" rel="noopener noreferrer" class="hover:text-light-accent dark:hover:text-dark-accent transition-colors border-b border-transparent hover:border-light-accent dark:hover:border-dark-accent pb-1">LinkedIn</a>
        <a href="https://github.com/realParthiv" target="_blank" rel="noopener noreferrer" class="hover:text-light-accent dark:hover:text-dark-accent transition-colors border-b border-transparent hover:border-light-accent dark:hover:border-dark-accent pb-1">GitHub</a>
      </div>
    </section>
  </div>
</Base>

<style>
  /* Hero Animations */
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-up {
    animation: fade-up 400ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
  }

  .delay-100 { animation-delay: 100ms; }
  .delay-200 { animation-delay: 200ms; }

  /* Scroll Reveal Defaults */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 600ms cubic-bezier(0.16, 1, 0.3, 1), transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  .reveal-on-scroll.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  // Intersection Observer for scroll-triggered reveals
  const setupObserver = () => {
    // Respect reduced motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    
    const observerOptions = {
      root: null,
      rootMargin: '0px 0px -50px 0px',
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          if (prefersReducedMotion) {
            // Immediate reveal without transition if reduced motion is preferred
            entry.target.style.transition = 'none';
          }
          entry.target.classList.add('is-revealed');
          observer.unobserve(entry.target); // Only reveal once
        }
      });
    }, observerOptions);

    const elements = document.querySelectorAll('.reveal-on-scroll');
    elements.forEach(el => observer.observe(el));
  };

  // Run on first load
  setupObserver();
  
  // Re-run setup after Astro view transitions (if enabled in future)
  document.addEventListener('astro:page-load', setupObserver);
</script>
