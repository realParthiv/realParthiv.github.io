---
import Base from '../layouts/Base.astro';
import VerifiedCapabilities from '../components/VerifiedCapabilities.astro';
import { getCollection } from 'astro:content';

const allBlogEntries = await getCollection('blog');
const sortedBlogEntries = allBlogEntries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const recentBlogEntries = sortedBlogEntries.slice(0, 2);
---

<Base>
  <div class="space-y-32">
    <!-- 1. HERO -->
    <section class="flex flex-col items-start gap-8">
      <div class="animate-fade-up w-14 h-14 rounded-full border border-light-accent dark:border-dark-accent flex items-center justify-center shrink-0">
        <span class="font-display font-semibold text-light-accent dark:text-dark-accent text-xl leading-none mt-1">PP</span>
      </div>
      
      <h1 class="animate-fade-up delay-100 font-display text-4xl sm:text-5xl md:text-6xl font-medium tracking-tight text-light-text dark:text-dark-text max-w-4xl leading-[1.15]">
        AI/ML Engineer — verified via production systems, not claims.
      </h1>
      
      <div class="animate-fade-up delay-200 font-data text-sm text-light-muted dark:text-dark-muted">
        currently @ Clicode — AI/ML Engineer
      </div>
    </section>

    <!-- 2. THESIS -->
    <section class="reveal-on-scroll flex flex-col items-start gap-6">
      <p class="font-body text-lg sm:text-xl leading-relaxed max-w-[65ch] text-light-text dark:text-dark-text">
        I build the layer between conversation and infrastructure — AI agents that read and write real data through MCP and RAG, backend systems that hold up under concurrent load, and the occasional smart contract when trust needs to be provable instead of promised.
      </p>
      <a href="/about" class="text-sm font-medium hover:text-light-accent dark:hover:text-dark-accent transition-colors flex items-center gap-1 group">
        More about how I got here 
        <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
      </a>
    </section>

    <!-- 3. EXPERIENCE -->
    <section class="reveal-on-scroll">
      <h2 class="font-display text-sm text-light-muted dark:text-dark-muted mb-8 uppercase tracking-wider">Experience</h2>
      <div class="flex flex-col gap-4">
        <div class="grid grid-cols-1 sm:grid-cols-[140px_1fr] gap-2 sm:gap-6 items-baseline">
          <div class="font-data text-sm text-light-muted dark:text-dark-muted">2026—present</div>
          <div class="font-medium text-light-text dark:text-dark-text">AI/ML Engineer, Clicode</div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-[140px_1fr] gap-2 sm:gap-6 items-baseline">
          <div class="font-data text-sm text-light-muted dark:text-dark-muted">2024—2026</div>
          <div class="font-medium text-light-text dark:text-dark-text">Associate Python Developer, Virtueinfo</div>
        </div>
      </div>
    </section>

    <!-- 4. LEDGER — SELECTED ENTRIES -->
