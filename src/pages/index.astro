      <h2 class="font-display text-sm text-light-muted dark:text-dark-muted mb-8 uppercase tracking-wider">Ledger — Selected Entries</h2>
      <div class="flex flex-col border-t border-light-hairline dark:border-dark-hairline">
        
        <a href="/work/academicshield" class="group grid grid-cols-1 md:grid-cols-[40px_2fr_3fr_60px_auto] gap-4 items-center py-4 border-b border-light-hairline dark:border-dark-hairline hover:bg-light-surface/50 dark:hover:bg-dark-surface/50 transition-colors">
          <div class="font-data text-sm text-light-muted dark:text-dark-muted">01</div>
          <div class="font-display font-medium text-light-text dark:text-dark-text group-hover:text-light-accent dark:group-hover:text-dark-accent transition-colors">AcademicShield</div>
          <div class="font-data text-xs text-light-muted dark:text-dark-muted">Django · Solidity · Ethereum · MySQL</div>
          <div class="font-data text-sm text-light-muted dark:text-dark-muted md:text-center">2025</div>
          <div class="font-data text-xs text-light-accent dark:text-dark-accent md:text-right">VERIFIED — LIVE</div>
        </a>

        <a href="/work/pujaguru" class="group grid grid-cols-1 md:grid-cols-[40px_2fr_3fr_60px_auto] gap-4 items-center py-4 border-b border-light-hairline dark:border-dark-hairline hover:bg-light-surface/50 dark:hover:bg-dark-surface/50 transition-colors">
          <div class="font-data text-sm text-light-muted dark:text-dark-muted">02</div>
          <div class="font-display font-medium text-light-text dark:text-dark-text group-hover:text-light-accent dark:group-hover:text-dark-accent transition-colors">PujaGuru</div>
          <div class="font-data text-xs text-light-muted dark:text-dark-muted">Django · MCP · MySQL · Django Channels</div>
          <div class="font-data text-sm text-light-muted dark:text-dark-muted md:text-center">2025</div>
          <div class="font-data text-xs text-light-accent dark:text-dark-accent md:text-right">VERIFIED — SHIPPED</div>
        </a>

        <a href="/work/nomoreguilts" class="group grid grid-cols-1 md:grid-cols-[40px_2fr_3fr_60px_auto] gap-4 items-center py-4 border-b border-light-hairline dark:border-dark-hairline hover:bg-light-surface/50 dark:hover:bg-dark-surface/50 transition-colors">
          <div class="font-data text-sm text-light-muted dark:text-dark-muted">03</div>
          <div class="font-display font-medium text-light-text dark:text-dark-text group-hover:text-light-accent dark:group-hover:text-dark-accent transition-colors">NoMoreGuilts</div>
          <div class="font-data text-xs text-light-muted dark:text-dark-muted">Django · Python · AI-assisted development</div>
          <div class="font-data text-sm text-light-muted dark:text-dark-muted md:text-center">2026</div>
          <div class="font-data text-xs text-light-accent dark:text-dark-accent md:text-right">VERIFIED — LIVE</div>
        </a>

        <a href="/work/neurotype" class="group grid grid-cols-1 md:grid-cols-[40px_2fr_3fr_60px_auto] gap-4 items-center py-4 border-b border-light-hairline dark:border-dark-hairline hover:bg-light-surface/50 dark:hover:bg-dark-surface/50 transition-colors">
          <div class="font-data text-sm text-light-muted dark:text-dark-muted">04</div>
          <div class="font-display font-medium text-light-text dark:text-dark-text group-hover:text-light-accent dark:group-hover:text-dark-accent transition-colors">NeuroType</div>
          <div class="font-data text-xs text-light-muted dark:text-dark-muted">TensorFlow · Keras · FastAPI · React · BiLSTM</div>
          <div class="font-data text-sm text-light-muted dark:text-dark-muted md:text-center">2026</div>
          <div class="font-data text-xs text-light-accent dark:text-dark-accent md:text-right">VERIFIED — SHIPPED</div>
        </a>

      </div>
      <div class="mt-6">
        <a href="/work" class="text-sm font-medium hover:text-light-accent dark:hover:text-dark-accent transition-colors flex items-center gap-1 group w-fit">
          Full work log
          <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
