---
import Base from '../../layouts/Base.astro';
import BackLink from '../../components/BackLink.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const workEntries = await getCollection('work');
  return workEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.summary} type="article"
  image={`/og/work-${entry.id}.png`}>
  <BackLink fallback="/work" label="Back to work log" class="mb-6" />
  <article class="space-y-12 animate-fade-up">

    <!-- Header (same ledger row format, no link) -->
    <div class="grid grid-cols-1 md:grid-cols-[40px_2fr_3fr_60px_auto] gap-4 items-center py-4 border-y border-light-hairline dark:border-dark-hairline">
      <div class="font-data text-sm text-light-muted dark:text-dark-muted">{String(entry.data.order).padStart(2, '0')}</div>
      <div class="font-display font-medium text-light-text dark:text-dark-text">{entry.data.title}</div>
      <div class="font-data text-xs text-light-muted dark:text-dark-muted">{entry.data.stack.join(' · ')}</div>
      <div class="font-data text-sm text-light-muted dark:text-dark-muted md:text-center">{entry.data.year}</div>
      <div class="font-data text-xs text-light-accent dark:text-dark-accent md:text-right">{entry.data.status}</div>
    </div>

    <!-- Body content -->
    <div class="space-y-8">
      {(entry.data.url || entry.data.repo) && (
        <div class="flex flex-wrap gap-x-6 gap-y-3 font-data text-xs uppercase tracking-widest">
          {entry.data.url && (
            <a href={entry.data.url} target="_blank" rel="noopener noreferrer" class="text-light-accent dark:text-dark-accent hover:opacity-70 transition-opacity flex items-center gap-2 group">
              <span class="w-1.5 h-1.5 rounded-full bg-light-accent dark:bg-dark-accent"></span>
              Live site
              <span class="group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">&nearr;</span>
            </a>
          )}
          {entry.data.repo && (
            <a href={entry.data.repo} target="_blank" rel="noopener noreferrer" class="text-light-text dark:text-dark-text hover:text-light-accent dark:hover:text-dark-accent transition-colors flex items-center gap-2 group">
              Source
              <span class="group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">&nearr;</span>
            </a>
          )}
        </div>
      )}

      <div class="prose prose-sm sm:prose-base dark:prose-invert max-w-none prose-headings:font-display prose-headings:font-medium prose-p:font-body prose-a:text-light-accent dark:prose-a:text-dark-accent hover:prose-a:opacity-80 prose-code:font-data prose-pre:border prose-pre:border-light-hairline dark:prose-pre:border-dark-hairline prose-pre:bg-light-surface/50 dark:prose-pre:bg-dark-surface/50 text-light-text dark:text-dark-text">
        <Content />
      </div>
    </div>

    <!-- Back link -->
    <div class="pt-12 border-t border-light-hairline dark:border-dark-hairline">
      <BackLink fallback="/work" label="Back to work log" />
    </div>
  </article>
</Base>
