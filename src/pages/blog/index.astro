---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allBlogEntries = await getCollection('blog');
const sortedBlogEntries = allBlogEntries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base>
  <div class="space-y-16 animate-fade-up relative">
    <header class="space-y-4 relative">
      <div class="absolute -left-10 -top-10 w-[30%] h-[100%] rounded-full bg-light-glow dark:bg-dark-glow blur-[120px] opacity-30 -z-10 pointer-events-none"></div>
      <h1 class="font-display text-4xl sm:text-6xl font-semibold tracking-tighter text-transparent bg-clip-text bg-gradient-to-br from-light-text to-light-muted dark:from-dark-text dark:to-dark-muted">
        Log
      </h1>
      <p class="font-data text-sm tracking-widest uppercase text-light-muted dark:text-dark-muted">Thoughts on infrastructure, ML, and architecture</p>
    </header>
    
    {sortedBlogEntries.length === 0 ? (
      <div class="font-data text-sm text-light-muted dark:text-dark-muted py-12 border border-dashed border-light-hairline dark:border-dark-hairline rounded-xl text-center bg-light-surface/30 dark:bg-dark-surface/30">
        No entries logged yet. First one's coming.
      </div>
    ) : (
      <div class="flex flex-col border-t border-light-hairline dark:border-dark-hairline">
        {sortedBlogEntries.map(entry => (
          <a href={`/blog/${entry.id}`} class="group py-10 border-b border-light-hairline dark:border-dark-hairline transition-all duration-300 hover:pl-4 hover:bg-gradient-to-r hover:from-light-glow hover:to-transparent dark:hover:from-dark-glow dark:hover:to-transparent">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-5">
              <h2 class="font-display font-medium text-2xl sm:text-3xl tracking-tight text-light-text dark:text-dark-text group-hover:text-light-accent dark:group-hover:text-dark-accent transition-colors">
                {entry.data.title}
              </h2>
              <time class="font-data text-xs uppercase tracking-widest text-light-muted dark:text-dark-muted px-2.5 py-1 border border-light-hairline dark:border-dark-hairline rounded-full shrink-0" datetime={entry.data.date.toISOString()}>
                {entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
            </div>
            <p class="font-body text-lg text-light-text/80 dark:text-dark-text/80 line-clamp-3 max-w-[75ch] leading-relaxed">
              {entry.data.excerpt}
            </p>
          </a>
        ))}
      </div>
    )}
  </div>
</Base>
