---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allBlogEntries = await getCollection('blog');
const sortedBlogEntries = allBlogEntries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base>
  <div class="space-y-12 animate-fade-up">
    <h1 class="font-display text-2xl font-medium text-light-text dark:text-dark-text uppercase tracking-wider">Log</h1>
    
    {sortedBlogEntries.length === 0 ? (
      <div class="font-data text-sm text-light-muted dark:text-dark-muted py-8 border-y border-light-hairline dark:border-dark-hairline">
        No entries logged yet. First one's coming.
      </div>
    ) : (
      <div class="flex flex-col border-t border-light-hairline dark:border-dark-hairline">
        {sortedBlogEntries.map(entry => (
          <a href={`/blog/${entry.id}`} class="group py-6 border-b border-light-hairline dark:border-dark-hairline hover:bg-light-surface/50 dark:hover:bg-dark-surface/50 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 mb-3">
              <h2 class="font-display font-medium text-xl text-light-text dark:text-dark-text group-hover:text-light-accent dark:group-hover:text-dark-accent transition-colors">
                {entry.data.title}
              </h2>
              <time class="font-data text-sm text-light-muted dark:text-dark-muted shrink-0" datetime={entry.data.date.toISOString()}>
                {entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
            </div>
            <p class="font-body text-base text-light-text/80 dark:text-dark-text/80 line-clamp-3">
              {entry.data.excerpt}
            </p>
          </a>
        ))}
      </div>
    )}
  </div>
</Base>
