---
import Base from '../../layouts/Base.astro';
import BackLink from '../../components/BackLink.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base
  title={entry.data.title}
  description={entry.data.excerpt}
  type="article"
  image={`/og/blog-${entry.id}.png`}
  publishedTime={entry.data.date.toISOString()}
>
  <BackLink fallback="/blog" label="Back to log" class="mb-6" />
  <article class="space-y-12 animate-fade-up">

    <!-- Header -->
    <header class="space-y-4 pb-8 border-b border-light-hairline dark:border-dark-hairline">
      <h1 class="font-display font-medium text-3xl sm:text-4xl text-light-text dark:text-dark-text leading-tight">
        {entry.data.title}
      </h1>
      <div class="flex flex-wrap items-center gap-4 font-data text-sm text-light-muted dark:text-dark-muted">
        <time datetime={entry.data.date.toISOString()}>
          {entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        
        {entry.data.tags && entry.data.tags.length > 0 && (
          <>
            <span class="text-light-hairline dark:text-dark-hairline">|</span>
            <div class="flex gap-2">
              {entry.data.tags.map(tag => (
                <span class="bg-light-surface dark:bg-dark-surface px-2 py-0.5 rounded text-xs border border-light-hairline dark:border-dark-hairline">
                  {tag}
                </span>
              ))}
            </div>
          </>
        )}
      </div>
    </header>

    <!-- Body content -->
    <div class="prose prose-lg dark:prose-invert max-w-[68ch] font-body prose-headings:font-display prose-headings:font-medium prose-headings:tracking-tight prose-headings:mt-12 prose-headings:mb-5 prose-a:no-underline hover:prose-a:underline prose-code:font-data prose-code:font-normal prose-pre:font-data prose-pre:border prose-pre:border-light-hairline dark:prose-pre:border-dark-hairline prose-blockquote:font-body prose-blockquote:not-italic prose-blockquote:font-normal prose-hr:my-12">
      <Content />
    </div>

    <!-- Back link -->
    <div class="pt-12 border-t border-light-hairline dark:border-dark-hairline">
      <BackLink fallback="/blog" label="Back to log" />
    </div>
  </article>
</Base>
